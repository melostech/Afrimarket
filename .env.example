# Django Secret Key (Generate a secure key for production)
SECRET_KEY=your-secret-key-here

# Debug Mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (Comma-separated list of hostnames/IPs)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=afrimarket_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# CORS Settings (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simple JWT Settings (Example values)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
